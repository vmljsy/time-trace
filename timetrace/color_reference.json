{
    "description": "Color Reference - Hex to ANSI Escape Code Mappings",
    "documentation": {
        "ansi_format": "\\033[<style>;<color>m where style: 0=normal, 1=bold, 2=dim, 3=italic, 4=underline, 5=blink, 7=reverse",
        "basic_colors": "30-37 for foreground, 40-47 for background",
        "bright_colors": "90-97 for foreground, 100-107 for background",
        "256_colors": "\\033[38;5;<n>m for foreground (n=0-255), \\033[48;5;<n>m for background",
        "true_color": "\\033[38;2;<r>;<g>;<b>m for RGB foreground"
    },
